APP_MODE=local
LOG_LEVEL=INFO

# Bind both services to loopback for local use.
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
API_BASE_URL=http://127.0.0.1:8000/v1

# Storage and local SQLite database
STORAGE_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Upload and in-process ingestion limits
MAX_UPLOAD_BYTES=26214400
UPLOAD_CHUNK_BYTES=1048576
MAX_PDF_PAGES=500
MAX_CONCURRENT_INGESTIONS=2
MAX_POLL_SECONDS=180

# OCR: auto | text_only | google_vision
OCR_MODE=text_only
GOOGLE_APPLICATION_CREDENTIALS=

# Embeddings and retrieval
EMBEDDING_MODEL=text-embedding-3-small
RERANK_MODE=bm25
TOP_K_DEFAULT=6
RERANK_TOP_N=20

# Answer provider: anthropic | openai
# The example below uses OpenAI for both embeddings and answers.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-sol
OPENAI_API_KEY=replace_with_your_openai_api_key
ANTHROPIC_API_KEY=

# Required only for APP_MODE=hosted. Use different random values of 16+ characters.
DEMO_ACCESS_KEY=
ADMIN_API_KEY=
